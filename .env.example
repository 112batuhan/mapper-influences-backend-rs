# Keep the surreal user as `backend`
SURREAL_USER=backend
SURREAL_PASS=password
SURREAL_URL=ws://localhost:8100

REDIS_URL=redis://localhost:6379

CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=

POST_LOGIN_REDIRECT_URI=http://localhost:3000/dashboard

JWT_SECRET_KEY=something_password_like

PORT=8000

ADMIN_PASSWORD=password

# Set this to true when you want to start periodical user updates
DAILY_UPDATE=false
# Leaderboard and graph caches are rebuilt in the background by default.
# Set this to false to only fill them when a request misses the cache
CACHE_REFRESH=true

# Backup credentials

# Where the scheduled database backups go. Only needed by the `backup` binary,
# the server itself doesn't touch any of these.
#
# All of it comes from the Cloudflare dashboard, under R2 Object Storage:
#  1. Create a bucket. Its name is R2_BUCKET.
#  2. The bucket's settings page shows the S3 API endpoint, which is your account
#     id plus r2.cloudflarestorage.com. That whole url is R2_ENDPOINT, without
#     the bucket name on the end.
#  3. "Manage R2 API tokens" -> create an API token. "Object Read & Write" is
#     enough, and scope it to the one bucket. Creating a bucket is done by hand
#     above, so the token never needs admin rights.
#  4. The token page then shows the access key id and the secret access key. The
#     secret is shown once and never again, so save it now.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=mapper-influences-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# How many dumps to keep. Older ones are deleted after each successful backup.
BACKUP_RETENTION=30

# Every backup is restored into a scratch database before the old ones are pruned.
# Needs the `surreal` binary and restore.sh, both of which are in the backup image.
# Set to false when running the script somewhere that has neither.
BACKUP_VERIFY=true

# Optional. The backup reads SURREAL_URL, SURREAL_USER and SURREAL_PASS above and
# talks to the export endpoint on the same host. Set these to back up a database
# that isn't the one the server uses.
# SURREAL_HTTP_URL=http://localhost:8000
# SURREAL_NAMESPACE=prod
# SURREAL_DATABASE=prod
